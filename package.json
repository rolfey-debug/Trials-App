{
  "name": "agnvet-trial-work",
  "private": true,
  "version": "1.0.0",
  "description": "AGnVET Trial Work — offline-first PWA for small-plot field trials: spray, assess, present",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "tsx test/parsers.test.ts && tsx test/groundwork.test.ts && tsx test/phenology.test.ts && tsx test/lai.test.ts && tsx test/stats.test.ts && tsx test/geofit.test.ts && tsx test/ortho.test.ts && tsx test/geometry.test.ts",
    "weather:build": "node shared/phenology/fetch-weather.mjs",
    "fonts:build": "node shared/fonts/build-fonts.mjs",
    "products:build": "node shared/products/build-products.mjs",
    "portal:dev": "vite portal",
    "portal:build": "vite build portal",
    "build:all": "tsc -b && vite build && vite build portal",
    "sql:fresh": "node server/build-fresh-project.mjs"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "fflate": "^0.8.2",
    "geotiff": "^3.0.5",
    "leaflet": "^1.9.4",
    "proj4": "^2.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/proj4": "^2.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
